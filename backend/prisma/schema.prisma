generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  SCANNER
}

enum MovieCategory {
  CINE
  TEATRO
  CONCIERTO
}

enum EventStatus {
  NOW_SHOWING
  COMING_SOON
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  EXPIRED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum StadiumTicketStatus {
  VALID
  USED
  EXPIRED
}

enum ParkingLotStatus {
  ACTIVE
  INACTIVE
}

enum ParkingTicketStatus {
  VALID
  USED
  EXPIRED
}

enum ParkingAccessMode {
  QR
  TARJETA
  TICKET
}

enum ParkingTicketMode {
  QR
  TARJETA
  TICKET
}

enum BusOriginTerminal {
  QUITUMBE
  CARCELEN
}

enum BusRouteStatus {
  ACTIVE
  INACTIVE
}

enum BusTripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
}

enum BusTicketStatus {
  VALID
  USED
  EXPIRED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  fullName      String?       @map("full_name")
  phone         String?
  passwordHash  String        @map("password_hash")
  role          UserRole      @default(CLIENT)
  createdAt     DateTime      @default(now()) @map("created_at")
  reservations  Reservation[]
  stadiumTickets StadiumTicket[]
  parkingTickets ParkingTicket[]
  busTickets     BusTicket[]

  @@map("users")
}

model ModuleSetting {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("module_settings")
}

model MovieEvent {
  id          String        @id @default(cuid())
  title       String
  synopsis    String
  duration    Int
  category    MovieCategory
  posterUrl   String        @map("poster_url")
  trailerUrl  String?       @map("trailer_url")
  rating      Decimal?      @db.Decimal(2, 1)
  status      EventStatus   @default(NOW_SHOWING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  showtimes   Showtime[]

  @@index([status, category])
  @@map("movie_events")
}

model Room {
  id         String     @id @default(cuid())
  name       String
  capacity   Int
  seatLayout Json       @map("seat_layout")
  showtimes  Showtime[]

  @@map("rooms")
}

model Showtime {
  id             String       @id @default(cuid())
  movieId        String       @map("movie_id")
  roomId         String       @map("room_id")
  startTime      DateTime     @map("start_time")
  price          Decimal      @db.Decimal(10, 2)
  availableSeats Int          @default(0) @map("available_seats")
  movie          MovieEvent   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservations   Reservation[]

  @@unique([movieId, roomId, startTime])
  @@index([startTime])
  @@index([movieId])
  @@map("showtimes")
}

model Reservation {
  id         String             @id @default(cuid())
  showtimeId String            @map("showtime_id")
  userId     String            @map("user_id")
  status     ReservationStatus @default(PENDING)
  expiresAt  DateTime?         @map("expires_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  showtime   Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@index([showtimeId, status])
  @@index([userId, status])
  @@map("reservations")
}

model Ticket {
  id            String      @id @default(cuid())
  reservationId String      @map("reservation_id")
  seatNumber    String      @map("seat_number")
  qrCodeHash    String      @unique @map("qr_code_hash")
  status        TicketStatus @default(VALID)
  usedAt        DateTime?   @map("used_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([status])
  @@map("tickets")
}

model Stadium {
  id          String          @id @default(cuid())
  name        String
  city        String
  capacity    Int
  imageUrl    String?         @map("image_url")
  seatLayout  Json            @map("seat_layout")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  sectors     StadiumSector[]
  matches     Match[]

  @@map("stadiums")
}

model StadiumSector {
  id          String          @id @default(cuid())
  stadiumId   String          @map("stadium_id")
  name        String
  code        String
  capacity    Int
  price       Decimal         @db.Decimal(10, 2)
  seatLayout  Json            @map("seat_layout")
  stadium     Stadium         @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  tickets     StadiumTicket[]

  @@unique([stadiumId, code])
  @@map("stadium_sectors")
}

model Match {
  id          String          @id @default(cuid())
  stadiumId   String          @map("stadium_id")
  homeTeam    String          @map("home_team")
  awayTeam    String          @map("away_team")
  startTime   DateTime        @map("start_time")
  status      MatchStatus     @default(SCHEDULED)
  stadium     Stadium         @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  tickets     StadiumTicket[]
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([stadiumId, startTime])
  @@index([startTime, status])
  @@map("matches")
}

model StadiumTicket {
  id          String              @id @default(cuid())
  matchId     String              @map("match_id")
  sectorId    String              @map("sector_id")
  userId      String              @map("user_id")
  seatNumber  String              @map("seat_number")
  qrCodeHash  String              @unique @map("qr_code_hash")
  status      StadiumTicketStatus @default(VALID)
  usedAt      DateTime?           @map("used_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  match       Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sector      StadiumSector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, sectorId, seatNumber])
  @@index([matchId, status])
  @@map("stadium_tickets")
}

model ParkingLot {
  id          String            @id @default(cuid())
  name        String
  address     String
  city        String
  totalSpaces Int               @map("total_spaces")
  price       Decimal           @db.Decimal(10, 2)
  operator    String
  openingHours String          @map("opening_hours")
  terminalName String?         @map("terminal_name")
  accessMode  ParkingAccessMode @default(QR) @map("access_mode")
  vehicleTypes Json             @map("vehicle_types")
  status      ParkingLotStatus  @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  tickets     ParkingTicket[]

  @@index([city, status])
  @@map("parking_lots")
}

model ParkingTicket {
  id          String              @id @default(cuid())
  parkingId   String              @map("parking_id")
  userId      String              @map("user_id")
  spaceNumber Int                 @map("space_number")
  date        DateTime
  entryTime   DateTime?         @map("entry_time")
  exitTime    DateTime?         @map("exit_time")
  ticketMode  ParkingTicketMode  @default(QR) @map("ticket_mode")
  entryMetadata Json             @map("entry_metadata")
  qrCodeHash  String              @unique @map("qr_code_hash")
  status      ParkingTicketStatus @default(VALID)
  usedAt      DateTime?           @map("used_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  parking     ParkingLot          @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([parkingId, spaceNumber, date])
  @@index([userId, status])
  @@map("parking_tickets")
}

model BusRoute {
  id            String          @id @default(cuid())
  origin        String
  destination   String
  operator      String
  originTerminal BusOriginTerminal @default(QUITUMBE) @map("origin_terminal")
  status        BusRouteStatus  @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  trips         BusTrip[]

  @@index([origin, destination, status])
  @@map("bus_routes")
}

model BusTrip {
  id            String        @id @default(cuid())
  routeId       String        @map("route_id")
  departureTime DateTime      @map("departure_time")
  arrivalTime   DateTime?     @map("arrival_time")
  boardingPlatform String?    @map("boarding_platform")
  baggageInfo   String?       @map("baggage_info")
  price         Decimal       @db.Decimal(10, 2)
  totalSeats    Int           @map("total_seats")
  status        BusTripStatus @default(SCHEDULED)
  route         BusRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  tickets       BusTicket[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([routeId, departureTime])
  @@index([departureTime, status])
  @@map("bus_trips")
}

model BusTicket {
  id          String           @id @default(cuid())
  tripId      String           @map("trip_id")
  userId      String           @map("user_id")
  seatNumber  Int              @map("seat_number")
  qrCodeHash  String           @unique @map("qr_code_hash")
  status      BusTicketStatus  @default(VALID)
  usedAt      DateTime?        @map("used_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  trip        BusTrip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@index([userId, status])
  @@map("bus_tickets")
}
